@model dynamic

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h3>Sign In</h3>

<form asp-action="Login" method="post" id="loginForm">
    <div class="mb-3">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" id="emailInput" class="form-control"
               placeholder="admin@example.com" required autofocus />
        <small class="text-danger" id="emailTimeoutWarning" style="display: none;">
            Session expired. Please re-enter your email.
        </small>
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" id="passwordInput" class="form-control"
               placeholder="Enter your password" required />
    </div>

    <button type="submit" class="btn btn-login">Sign In</button>
</form>

<div class="mt-3 text-center">
    <p class="text-muted mb-2" style="font-size: 0.85rem;">Don't have an account?</p>
    <a asp-controller="Account" asp-action="Register" class="btn btn-register w-100">
        Create New Account
    </a>
</div>

<div class="text-center mt-3">
    <small class="text-muted">
        Only authorized Librarians and Admins can access this system.
    </small>
</div>

<!-- Login Form Timeout Security Script -->
<script>
    (function() {
        const emailInput = document.getElementById('emailInput');
        const passwordInput = document.getElementById('passwordInput');
        const emailTimeoutWarning = document.getElementById('emailTimeoutWarning');
        const loginForm = document.getElementById('loginForm');

        let emailFieldTimeout = null;
        let emailTimeoutExpired = false;
        const TIMEOUT_DURATION = 10000;

        emailInput.addEventListener('input', function() {
            if (emailFieldTimeout) {
                clearTimeout(emailFieldTimeout);
            }
            emailTimeoutExpired = false;

            if (emailInput.value.trim() !== '') {
                emailTimeoutWarning.style.display = 'none';

                emailFieldTimeout = setTimeout(function() {
                    emailTimeoutExpired = true;
                    emailFieldTimeout = null;
                }, TIMEOUT_DURATION);
            }
        });

        passwordInput.addEventListener('focus', function() {
            if (emailInput.value.trim() !== '' && emailTimeoutExpired) {
                emailInput.value = '';
                emailTimeoutWarning.style.display = 'block';
                emailInput.focus();

                setTimeout(function() {
                    emailTimeoutWarning.style.display = 'none';
                }, 3000);

                emailTimeoutExpired = false;
            }
        });

        emailInput.addEventListener('focus', function() {
            if (emailFieldTimeout) {
                clearTimeout(emailFieldTimeout);
                emailFieldTimeout = null;
            }
            emailTimeoutExpired = false;
            emailTimeoutWarning.style.display = 'none';
        });

        loginForm.addEventListener('submit', function(e) {
            if (emailInput.value.trim() === '') {
                e.preventDefault();
                emailTimeoutWarning.textContent = 'Email field is empty. Please enter your email.';
                emailTimeoutWarning.style.display = 'block';
                emailInput.focus();

                setTimeout(function() {
                    emailTimeoutWarning.style.display = 'none';
                }, 3000);
            }
        });
    })();
</script>
