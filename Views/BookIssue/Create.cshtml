@model Practice_Project.Models.BookIssueViewModel

@{
    ViewData["Title"] = "Issue New Book";
}

<style>
    .page-header {
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .form-card label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 4px;
    }

    .form-card .form-select {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.875rem;
    }

    .form-card .form-select:focus {
        border-color: #0018a8;
        box-shadow: 0 0 0 3px rgba(0, 24, 168, 0.08);
    }

    .field-validation-error,
    .text-danger {
        font-size: 0.78rem;
        color: #dc3545 !important;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-app-primary {
        background: #0018a8;
        color: #ffffff;
        border: 1px solid #0018a8;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .btn-app-primary:hover {
        background: #0015d4;
        border-color: #0015d4;
        color: #ffffff;
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Issue New Book</h1>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="BookId" class="form-label"></label>
                <select asp-for="BookId" class="form-select" asp-items="@(new SelectList(ViewBag.Books, "Id", "Title"))">
                    <option value="">-- Select Book --</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId" class="form-select" asp-items="@(new SelectList(ViewBag.Students, "Id", "Name"))">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-app-secondary">Cancel</a>
            <button type="submit" class="btn-app-primary">
                <i class="bx bx-check"></i> Issue Book
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
