@model Practice_Project.Entities.BookIssue

@{
    ViewData["Title"] = "Return Book";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .detail-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .field-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 4px;
    }

    .field-value {
        font-size: 0.9rem;
        color: #1a1d2e;
        font-weight: 600;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-app-primary {
        background: #0018a8;
        color: #ffffff;
        border: 1px solid #0018a8;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .btn-app-primary:hover {
        background: #0015d4;
        border-color: #0015d4;
        color: #ffffff;
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Return Book</h1>
</div>

<div class="detail-card">
    <div class="row g-4">
        <div class="col-md-6">
            <span class="field-label">Book Title</span>
            <div class="field-value">@Model.Book.Title</div>
        </div>

        <div class="col-md-6">
            <span class="field-label">Author</span>
            <div class="field-value">@Model.Book.Author?.Name</div>
        </div>

        <div class="col-md-6">
            <span class="field-label">Student</span>
            <div class="field-value">@Model.Student.Name</div>
        </div>

        <div class="col-md-6">
            <span class="field-label">Issue Date</span>
            <div class="field-value">@Model.IssueDate</div>
        </div>

        <div class="col-md-6">
            <span class="field-label">Due Date</span>
            <div class="field-value">@Model.DueDate</div>
        </div>

        <div class="col-md-6">
            <span class="field-label">Today's Date</span>
            <div class="field-value">@DateTime.UtcNow</div>
        </div>
    </div>

    <form asp-action="Return" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <a asp-action="Index" class="btn-app-secondary">Cancel</a>
            <button type="submit" class="btn-app-primary">Proceed to Return</button>
        </div>
    </form>
</div>
