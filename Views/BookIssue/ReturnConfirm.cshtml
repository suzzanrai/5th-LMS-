@model Practice_Project.Entities.BookIssue

@{
    ViewData["Title"] = "Confirm Fine Payment";
}

<style>
    .confirm-card {
        max-width: 720px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 28px;
    }

    .confirm-header {
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 22px;
        margin-bottom: 24px;
    }

    .confirm-icon {
        color: #f59e0b;
        font-size: 3rem;
        margin-bottom: 10px;
    }

    .confirm-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
        margin-bottom: 8px;
    }

    .confirm-text {
        color: #64748b;
        font-size: 0.9rem;
        margin: 0;
    }

    .fine-amount {
        font-size: 2.4rem;
        font-weight: 800;
        color: #dc3545;
        margin: 0;
    }

    .field-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 4px;
    }

    .field-value {
        font-size: 0.9rem;
        color: #1a1d2e;
        font-weight: 600;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-app-primary {
        background: #0018a8;
        color: #ffffff;
        border: 1px solid #0018a8;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .btn-app-primary:hover {
        background: #0015d4;
        border-color: #0015d4;
        color: #ffffff;
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="confirm-card">
    <div class="confirm-header">
        <div class="confirm-icon"><i class="bx bx-error-circle"></i></div>
        <h1 class="confirm-title">Overdue Fine Detected</h1>
        <p class="confirm-text">Collect the fine before completing the return process.</p>
    </div>

    <div class="row g-4 align-items-center">
        <div class="col-md-5 text-center">
            <span class="field-label">Fine Amount</span>
            <p class="fine-amount">₹@ViewBag.CalculatedFine</p>
            <p class="confirm-text">Overdue by <strong>@ViewBag.OverdueDays day(s)</strong>, rate ₹5 per day.</p>
        </div>

        <div class="col-md-7">
            <div class="row g-3">
                <div class="col-12">
                    <span class="field-label">Book</span>
                    <div class="field-value">@Model.Book.Title</div>
                </div>

                <div class="col-12">
                    <span class="field-label">Student</span>
                    <div class="field-value">@Model.Student.Name</div>
                </div>

                <div class="col-md-6">
                    <span class="field-label">Due Date</span>
                    <div class="field-value">@Model.DueDate</div>
                </div>

                <div class="col-md-6">
                    <span class="field-label">Return Date</span>
                    <div class="field-value">@ViewBag.ReturnDate</div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Return" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="action" value="confirm" />

        <div class="form-actions">
            <a asp-action="Index" class="btn-app-secondary">Cancel</a>
            <button type="submit" class="btn-app-primary">Collect Fine & Return Book</button>
        </div>
    </form>
</div>
