@model Practice_Project.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<style>
    .page-header {
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .form-card label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 4px;
    }

    .form-card .form-control {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.875rem;
    }

    .form-card .form-control:focus {
        border-color: #0018a8;
        box-shadow: 0 0 0 3px rgba(0, 24, 168, 0.08);
    }

    .field-validation-error,
    .text-danger {
        font-size: 0.78rem;
        color: #dc3545 !important;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-app-primary {
        background: #0018a8;
        color: #ffffff;
        border: 1px solid #0018a8;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .btn-app-primary:hover {
        background: #0015d4;
        border-color: #0015d4;
        color: #ffffff;
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Edit Category</h1>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">
        <input type="hidden" asp-for="CategoryId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Enter description (optional)"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-app-secondary">Cancel</a>
            <button type="submit" class="btn-app-primary">Update</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
