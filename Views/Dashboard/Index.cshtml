@model Practice_Project.Models.DashboardViewModel

@{
    ViewData["Title"] = "Library Dashboard";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .page-subtitle {
        margin: 4px 0 0;
        font-size: 0.85rem;
        color: #64748b;
    }

    .stat-card,
    .content-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        padding: 22px;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: rgba(0, 24, 168, 0.08);
        color: #0018a8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex: 0 0 auto;
    }

    .stat-value {
        font-size: 1.8rem;
        line-height: 1;
        font-weight: 800;
        color: #1a1d2e;
        margin: 0 0 6px;
    }

    .stat-label {
        margin: 0;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
    }

    .content-card {
        padding: 24px;
        margin-top: 24px;
    }

    .section-title {
        margin: 0 0 16px;
        font-size: 1rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .app-table {
        width: 100%;
        margin: 0;
    }

    .app-table thead {
        background: #f8fafc;
    }

    .app-table th {
        padding: 12px 16px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        border-bottom: 1px solid #e2e8f0;
    }

    .app-table td {
        padding: 14px 16px;
        font-size: 0.875rem;
        color: #1a1d2e;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .app-table tbody tr:hover {
        background: #f8fafc;
    }

    .empty-state {
        padding: 28px;
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
        border: 1px dashed #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Monitor library activity, circulation, and pending fines.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-book"></i></div>
            <div>
                <p class="stat-value">@Model.TotalBooks</p>
                <p class="stat-label">Total Books</p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bxs-graduation"></i></div>
            <div>
                <p class="stat-value">@Model.TotalStudents</p>
                <p class="stat-label">Students</p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-transfer"></i></div>
            <div>
                <p class="stat-value">@Model.CurrentlyIssued</p>
                <p class="stat-label">Issued Books</p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon"><i class="bx bx-receipt"></i></div>
            <div>
                <p class="stat-value">@Model.TotalPendingFine</p>
                <p class="stat-label">Pending Fines</p>
            </div>
        </div>
    </div>
</div>

<div class="content-card">
    <h2 class="section-title">Overdue Issues</h2>

    @if (Model.OverdueBooks.Any())
    {
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Student</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th class="text-end">Fine</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in Model.OverdueBooks)
                    {
                        <tr>
                            <td>@issue.Book?.Title</td>
                            <td>@issue.Student?.Name</td>
                            <td>@issue.IssueDate.ToString("dd MMM yyyy")</td>
                            <td>@issue.DueDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end text-danger fw-semibold">₹@issue.FineAmount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            No overdue book issues are currently recorded.
        </div>
    }
</div>
