@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .page-header {
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .page-subtitle {
        margin: 4px 0 0;
        font-size: 0.85rem;
        color: #64748b;
    }

    .content-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .content-card p {
        font-size: 0.9rem;
        color: #1a1d2e;
        line-height: 1.6;
        margin-bottom: 12px;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Privacy Policy</h1>
    <p class="page-subtitle">How we handle your data</p>
</div>

<div class="content-card">
    <p>
        This Library Management System is designed for institutional use. All student and staff data
        is stored securely and accessed only by authorized personnel.
    </p>
    <p>
        Personal information such as names, email addresses, and phone numbers is used solely for
        library operations including book issuance, fine management, and student record keeping.
    </p>
    <p>
        Data is never shared with third parties. If you have any questions about this privacy policy,
        please contact the system administrator.
    </p>
</div>
