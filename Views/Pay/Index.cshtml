@model IEnumerable<Practice_Project.Entities.Fine>

@{
    ViewData["Title"] = "Paid Fines";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .page-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .view-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .search-input {
        width: 260px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.875rem;
    }

    .search-input:focus {
        border-color: #0018a8;
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 24, 168, 0.08);
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }

    .app-table {
        width: 100%;
        margin: 0;
    }

    .app-table thead {
        background: #f8fafc;
    }

    .app-table th {
        padding: 12px 16px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .app-table td {
        padding: 14px 16px;
        font-size: 0.875rem;
        color: #1a1d2e;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .app-table tbody tr:hover {
        background: #f8fafc;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .status-paid {
        background: rgba(22, 163, 74, 0.1);
        color: #16a34a;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Paid Fines</h1>
    <div class="page-actions">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <input class="search-input"
                   type="text"
                   name="searchString"
                   placeholder="Search by student name"
                   aria-label="Search"
                   value="@ViewData["CurrentFilter"]" />

            <button class="btn-app-secondary" type="submit">Search</button>
            <a asp-action="Index" class="btn-app-secondary">Reset</a>
        </form>
    </div>
</div>

<div class="view-card">
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th class="text-end">Fine Amount</th>
                    <th class="text-end">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No paid fines found.</td>
                    </tr>
                }
                else
                {
                    foreach (var fine in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@fine.Student?.Name</td>
                            <td>@fine.BookIssue?.Book?.Title</td>
                            <td>@fine.BookIssue?.IssueDate.ToString("dd MMM yyyy")</td>
                            <td>@fine.BookIssue?.DueDate.ToString("dd MMM yyyy")</td>
                            <td>@(fine.BookIssue?.ReturnDate.HasValue == true ? fine.BookIssue.ReturnDate.Value.ToString("dd MMM yyyy") : "-")</td>
                            <td class="text-end fw-semibold">Rs. @fine.Amount</td>
                            <td class="text-end">
                                <span class="status-badge status-paid">Paid</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
