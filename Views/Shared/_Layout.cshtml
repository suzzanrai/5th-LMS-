@using System.Globalization
@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var nepalTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Nepal Standard Time");
    var currentNepalTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, nepalTimeZone);
    var formattedTime = currentNepalTime.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture);

    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "Admin";
    var firstName = userName.Split(' ').FirstOrDefault() ?? "Admin";
    var firstLetter = string.IsNullOrEmpty(userName) ? "U" : userName.First().ToString().ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; font-family: 'Inter', sans-serif; background: #ebeef1; color: #1a1d2e; min-height: 100vh; }
        .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 240px; background: #0018a8; padding: 24px 16px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; z-index: 1100; }
        .sidebar-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; padding: 8px 12px 20px 12px; }
        .sidebar-logo i { color: #ffffff; font-size: 1.8rem; }
        .sidebar-logo-text { display: flex; flex-direction: column; line-height: 1.2; }
        .sidebar-logo-text span:first-child { font-size: 1.2rem; font-weight: 700; color: #ffffff; }
        .sidebar-logo-text span:last-child { font-size: 0.75rem; color: rgba(255,255,255,0.75); font-weight: 500; }
        .sidebar-divider { height: 1px; background-color: rgba(255,255,255,0.25); margin: 0 12px 16px 12px; }
        .sidebar a:not(.logout-btn):not(.sidebar-logo) { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.85); text-decoration: none; padding: 12px 16px; border-radius: 10px; font-size: 0.9rem; transition: all 0.15s; }
        .sidebar a i { font-size: 1.2rem; }
        .sidebar a:hover:not(.logout-btn):not(.sidebar-logo) { background: rgba(255, 255, 255, 0.10); color: #ffffff; }
        .sidebar a.active { background: rgba(255, 255, 255, 0.18); color: #ffffff; font-weight: 600; }
        .sidebar-spacer { flex: 1; }
        .logout-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; background: transparent; border: 1.5px solid rgba(255,255,255,0.6); color: #fff; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.2s; width: 100%; margin-top: 8px; }
        .logout-btn:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
        .top { display: flex; justify-content: space-between; align-items: center; padding: 0 40px; background: #ffffff; height: 80px; border-bottom: 1px solid #e2e8f0; position: fixed; top: 0; left: 240px; width: calc(100% - 240px); z-index: 1000; }
        .top-time { display: flex; align-items: center; color: #252627; font-weight: 500; font-size: 1.1rem; }
        .top-right { display: flex; align-items: center; gap: 16px; }
        .profile-section { display: flex; align-items: center; gap: 10px; }
        .profile-avatar { width: 38px; height: 38px; background: #0018a8; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; }
        .profile-name { display: flex; flex-direction: column; line-height: 1.2; }
        .profile-name .hello { font-size: 0.75rem; color: #64748b; }
        .profile-name .name { font-size: 0.9rem; font-weight: 600; color: #1a1d2e; }
        .main-container { display: flex; margin-top: 80px; margin-left: 240px; min-height: calc(100vh - 80px); }
        .content { flex: 1; padding: 10px 10px; width: 100%; }
        .main-content { background: #ffffff; padding: 36px; max-width: 1400px; width: 100%; margin: 0 auto; border-radius: 16px; border: 1px solid #e2e8f0; }
        .footer { padding: 20px; background: #0018a8; color: rgba(255,255,255,0.8); text-align: center; font-size: 13px; margin-left: 240px; }
        .footer a { color: rgba(255,255,255,0.9); text-decoration: none; }
        .footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="sidebar">
    <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
        <i class='bx bx-book-open'></i>
        <div class="sidebar-logo-text">
            <span>Library</span>
            <span>Management System</span>
        </div>
    </a>
    <div class="sidebar-divider"></div>

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-controller="Dashboard" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Dashboard") ? "active" : "")">
            <i class='bx bxs-dashboard'></i> <span>Dashboard</span>
        </a>
        <a asp-controller="Student" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Student") ? "active" : "")">
            <i class='bx bxs-graduation'></i> <span>Students</span>
        </a>
        <a asp-controller="Authors" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Authors") ? "active" : "")">
            <i class='bx bx-edit-alt'></i> <span>Authors</span>
        </a>
        <a asp-controller="Categories" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Categories") ? "active" : "")">
            <i class='bx bx-category'></i> <span>Categories</span>
        </a>
        <a asp-controller="Books" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Books") ? "active" : "")">
            <i class='bx bx-book'></i> <span>Books</span>
        </a>
        <a asp-controller="BookIssue" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/BookIssue") ? "active" : "")">
            <i class='bx bx-transfer'></i> <span>Book Issue</span>
        </a>
        <a asp-controller="Pay" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Pay") ? "active" : "")">
            <i class='bx bx-receipt'></i> <span>Pay / Fine</span>
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Account" asp-action="Register" class="@(Context.Request.Path.StartsWithSegments("/Account/Register") ? "active" : "")">
                <i class='bx bx-user-plus'></i> <span>Register Staff</span>
            </a>
        }
        <div class="sidebar-spacer"></div>
        <button type="button" id="logoutBtn" class="logout-btn" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
            <i class='bx bx-log-out'></i> <span>Logout</span>
        </button>
    }
</div>

<div class="top">
    <div class="top-time"><span>@formattedTime</span></div>
    <div class="top-right">
        <div id="session-timer-display" style="font-size: 0.85rem; color: #64748b; background: #f1f5f9; padding: 4px 10px; border-radius: 20px; font-weight: 600; display: flex; align-items: center; gap: 5px;"><i class='bx bx-time-five'></i> <span id="timer-seconds">30s</span></div>
        <div class="profile-section">
            <div class="profile-avatar">@firstLetter</div>
            <div class="profile-name">
                <span class="hello">Hello,</span>
                <span class="name">@firstName</span>
            </div>
        </div>
    </div>
</div>

<div class="main-container">
    <div class="content">
        <div class="main-content">@RenderBody()</div>
    </div>
</div>

<div class="footer">
    &copy; 2025 Library Management System. All rights reserved. |
    <a href="#">Privacy Policy</a> | <a href="#">Terms of Service</a>
</div>

<!-- Modals -->
<div class="modal fade" id="logoutConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5>Confirm Logout</h5></div>
            <div class="modal-body"><p>Are you sure you want to logout?</p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-danger">Yes, Logout</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sessionTimeoutModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning"><h5>⏰ Session Expiring</h5></div>
            <div class="modal-body"><p>Your session will expire in <span id="timeoutCountdown">10</span> seconds.</p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="window.location.href='/Account/Logout'">Logout Now</button>
                <button type="button" class="btn btn-warning" onclick="extendSession()">Extend Session</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- SESSION TIMER SCRIPT -->
<script>
    const isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());
    
    if (isAuthenticated) {
        let timeLeft = 180;
        const timerText = document.getElementById("timer-seconds");

        const countdown = setInterval(function() {
            timeLeft--;
            if (timerText) timerText.innerText = timeLeft + "s";
            
            if (timeLeft <= 10) {
                const modalEl = document.getElementById("sessionTimeoutModal");
                if (modalEl && !modalEl.classList.contains("show")) {
                    document.getElementById("timeoutCountdown").innerText = timeLeft;
                    new bootstrap.Modal(modalEl).show();
                }
            }

            if (timeLeft <= 0) {
                clearInterval(countdown);
                window.location.href = "/Account/Logout";
            }
        }, 1000);

        window.extendSession = function() {
            timeLeft = 180;
            const modalEl = document.getElementById("sessionTimeoutModal");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            fetch('/Account/Index'); 
        };

        document.addEventListener("mousemove", function() {
            const modalEl = document.getElementById("sessionTimeoutModal");
            if (modalEl && !modalEl.classList.contains("show")) {
                timeLeft = 180;
            }
        });
    } else {
        // Hide timer if not logged in
        const timerDisplay = document.getElementById("session-timer-display");
        if (timerDisplay) timerDisplay.style.display = "none";
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
