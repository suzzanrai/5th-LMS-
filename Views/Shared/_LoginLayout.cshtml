<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #111827;
        }

        .login-page {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }

        .login-header {
            background: #1e3c72;
            color: #ffffff;
            text-align: center;
            padding: 24px 22px 20px;
        }

        .login-header h2 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 800;
            line-height: 1.3;
        }

        .login-header p {
            margin: 8px 0 0;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.82);
        }

        .login-body {
            padding: 24px;
        }

        .login-body h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1e3c72 !important;
            margin-bottom: 20px !important;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #374151;
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 6px;
            border: 1px solid #d1d5db;
            padding: 10px 12px;
            font-size: 0.92rem;
            min-height: 42px;
            box-shadow: none;
        }

        .form-control:focus {
            border-color: #1e3c72;
            box-shadow: 0 0 0 0.18rem rgba(30, 60, 114, 0.16);
        }

        .btn-login {
            width: 100%;
            border: none;
            border-radius: 6px;
            background: #1e3c72;
            padding: 10px 14px;
            font-size: 0.95rem;
            font-weight: 700;
            color: #ffffff;
        }

        .btn-login:hover,
        .btn-login:focus {
            background: #17325f;
            color: #ffffff;
        }

        .btn-register {
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-weight: 700;
        }

        .alert {
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .text-muted {
            color: #6b7280 !important;
        }

        .login-footer {
            text-align: center;
            margin-top: 16px;
            font-size: 0.78rem;
            color: #6b7280;
        }

        @@media (max-width: 480px) {
            body {
                padding: 16px;
            }

            .login-body {
                padding: 20px;
            }

            .login-header h2 {
                font-size: 1.15rem;
            }
        }
    </style>
</head>

<body>
    <main class="login-page">
        <section class="login-card">
            <div class="login-header">
                <h2>Library Management System</h2>
                <p>Secure access for authorized users</p>
            </div>

            <div class="login-body">
                @RenderBody()
            </div>
        </section>

        <div class="login-footer">
            &copy; 2026 Library Management System
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            history.replaceState(null, null, location.href);

            window.addEventListener('popstate', function () {
                history.replaceState(null, null, location.href);

                if (document.referrer && (
                    document.referrer.includes('/Dashboard') ||
                    document.referrer.includes('/Student') ||
                    document.referrer.includes('/Authors') ||
                    document.referrer.includes('/Categories') ||
                    document.referrer.includes('/Books') ||
                    document.referrer.includes('/BookIssue') ||
                    document.referrer.includes('/Pay'))) {
                    window.location.href = location.href;
                }
            });

            if ('caches' in window) {
                caches.keys().then(function (cacheNames) {
                    return Promise.all(
                        cacheNames.map(function (cacheName) {
                            return caches.delete(cacheName);
                        })
                    );
                });
            }

            window.onload = function () {
                history.pushState(null, null, location.href);
                window.onpopstate = function () {
                    history.pushState(null, null, location.href);
                };
            };
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>