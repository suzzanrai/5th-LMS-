@model IEnumerable<Practice_Project.Models.StudentVm>

@{
    ViewData["Title"] = "Students List";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1d2e;
    }

    .page-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .view-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
    }

    .search-input {
        width: 260px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.875rem;
    }

    .search-input:focus {
        border-color: #0018a8;
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 24, 168, 0.08);
    }

    .btn-app-primary {
        background: #0018a8;
        color: #ffffff;
        border: 1px solid #0018a8;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s ease;
    }

    .btn-app-primary:hover {
        background: #0015d4;
        border-color: #0015d4;
        color: #ffffff;
    }

    .btn-app-secondary {
        background: #ffffff;
        color: #1a1d2e;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        text-decoration: none;
        font-size: 1.05rem;
    }

    .btn-icon.edit {
        color: #0018a8;
    }

    .btn-icon.delete {
        color: #dc3545;
    }

    .app-table {
        width: 100%;
        margin: 0;
    }

    .app-table thead {
        background: #f8fafc;
    }

    .app-table th {
        padding: 12px 16px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        border-bottom: 1px solid #e2e8f0;
    }

    .app-table td {
        padding: 14px 16px;
        font-size: 0.875rem;
        color: #1a1d2e;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .app-table tbody tr:hover {
        background: #f8fafc;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Students</h1>
    <div class="page-actions">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <input class="search-input"
                   type="text"
                   name="searchString"
                   placeholder="Search by student name"
                   aria-label="Search"
                   value="@ViewData["CurrentFilter"]" />

            <button class="btn-app-secondary" type="submit">Search</button>
            <a asp-action="Index" class="btn-app-secondary">Reset</a>
        </form>

        <a asp-action="Create" class="btn-app-primary">
            <i class="bx bx-plus"></i> Add New
        </a>
    </div>
</div>

<div class="view-card">
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Roll Number</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.RollNumberDisplay</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn-icon edit" aria-label="Edit student">
                                <i class="bx bx-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn-icon delete" aria-label="Delete student">
                                <i class="bx bx-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
