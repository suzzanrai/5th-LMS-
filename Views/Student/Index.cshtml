@model IEnumerable<Practice_Project.Models.StudentVm>

@{
    ViewData["Title"] = "Students List";
}
<div class="container mt-4">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-success fw-bold ">Students Management</h2>
    
    <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
        <input class="form-control "
               type="text"
               name="searchString"
               placeholder="Search by student name"
               aria-label="Search"
               value="@ViewData["CurrentFilter"]"/>

        <button class="btn btn-outline-success" type="submit">
            Search
        </button>
      

        <a asp-action="Index" class="btn btn-outline-success">
            Reset
        </a>
    </form>
    
    
    <a asp-action="Create" class="btn btn-success btn-lg">
        Add New Students
    </a>
   
</div>


<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Roll Number</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.RollNumber</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
